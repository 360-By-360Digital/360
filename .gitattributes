# Automatically normalize text files
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix/Linux scripts
*.sh text eol=lf

# Source code
*.html text
*.css text
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text
*.xml text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Archives
*.zip binary
*.7z binary
*.rar binary
*.tar binary
*.gz binary

# Desktop installers
*.exe binary
*.msi binary
*.deb binary
*.apk binary
*.dll binary
*.so binary
*.dylib binary

# Audio & Video
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary
*.webm binary
