{
  "manifest_version": 3,
  "name": "360 New Tab",
  "short_name": "360",
  "version": "2.0.3",
  "description": "Use 360 as your Chrome New Tab home screen.",
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "../favicon-16x16.png",
    "32": "../favicon-32x32.png",
    "192": "../android-chrome-192x192.png",
    "512": "../android-chrome-512x512.png"
  }
}
